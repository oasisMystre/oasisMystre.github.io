---
import BaseHead from "../components/BaseHead.astro";
import Icon from "../components/Icon.astro";
import SvgIcons from "../components/SvgIcons.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<SvgIcons />
		<header>
			<h1>Oguntunde Caleb Fiyinfoluwa</h1>
			<p class="tagline">Systems and Infrastructure Engineer</p>

			<div class="social-links">
				<a href="mailto:payouk.mystre@gmail.com" aria-label="Email" title="Email">
					<Icon name="email" size={18} />
				</a>
				<a href="https://github.com/oasisMystre" target="_blank" rel="noreferrer" aria-label="GitHub" title="GitHub">
					<Icon name="github" size={18} />
				</a>
				<a href="https://x.com/0nisaibogu" target="_blank" rel="noreferrer" aria-label="X / Twitter" title="X / Twitter">
					<Icon name="x" size={18} />
				</a>
				<a href="https://t.me/onisaibogu" target="_blank" rel="noreferrer" aria-label="Telegram" title="Telegram">
					<Icon name="telegram" size={18} />
				</a>
				<a href="https://desk0.app" target="_blank" rel="noreferrer" aria-label="Desk0 Website" title="Desk0 Website">
					<Icon name="desk0" size={18} />
				</a>
			</div>
		</header>

		<main>
			<section>
				<h2>About</h2>
				<p>
					Systems and infrastructure engineer specializing in low level systems in Rust and C++, real time networking protocols, and high throughput financial data pipelines. Experienced in designing validator-level blockchain ingestion systems, time-series analytical databases, and low latency inter-process communication architectures.
				</p>
			</section>

			<section>
				<h2>Projects</h2>

				<div class="project-entry">
					<h3>Desk0</h3>
					<div class="sub">Open source remote desktop and endpoint management infrastructure</div>
					<div class="links">
						<a href="https://desk0.app">[desk0.app]</a>
						<a href="https://github.com/oasisMystre/desk0">[github]</a>
					</div>
					<p>
						Desk0 is an open source remote desktop and endpoint management platform written in Rust. Features a bidirectional WebSocket proxy relay for real time stream routing and an IPC interserver for communication between sessions.
					</p>

					<div class="section-block">
						<div class="block-title">WebSocket Relay Proxy</div>
						<div class="block-sub">Bidirectional stream routing</div>
						<p>
							Built a bidirectional proxy server using axum, tokio, and tokio-rustls. Connects viewers and remote agents over encrypted WebSockets across network boundaries without opening inbound ports on client endpoints.
						</p>
					</div>

					<div class="section-block">
						<div class="block-title">IPC Interserver</div>
						<div class="block-sub">Cross-session communication</div>
						<p>
							Engineered an IPC interserver to coordinate messaging, input dispatch, and state synchronization between background management services and active desktop sessions.
						</p>
					</div>
				</div>

				<div class="project-entry">
					<h3>Rhiva</h3>
					<div class="sub">High frequency Solana trading terminal and liquidity aggregator</div>
					<div class="links">
						<a href="https://rhiva.fun">[rhiva.fun]</a>
						<a href="https://github.com/oasisMystre/carbon">[carbon fork]</a>
						<a href="https://github.com/sevenlabs-hq/carbon" target="_blank" rel="noreferrer">[upstream sevenlabs-hq/carbon]</a>
					</div>
					<p>
						Founding developer and solo DevOps engineer for Rhiva, designing the architecture from an early liquidity aggregator into an on-chain trading terminal handling real-time DEX state across the Solana network.
					</p>

					<div class="section-block">
						<div class="block-title">Yellowstone Geyser Ingestion</div>
						<div class="block-sub">Direct validator gRPC streaming</div>
						<p>
							Replaced standard rate-limited HTTP JSON-RPC connections with direct Yellowstone Geyser gRPC validator feeds. Captured real-time slot commitments and transaction executions directly from the validator gossip network, reducing transaction confirmation notification latency from 2.5 seconds down to sub-300 milliseconds.
						</p>
					</div>

					<div class="section-block">
						<div class="block-title">ClickHouse Storage Engine</div>
						<div class="block-sub">Real-time analytical time-series cluster</div>
						<p>
							Designed and maintained a production ClickHouse database cluster processing sustained bursts of over 2,500 on-chain events per second. Delivered sub-15 millisecond query response times for live orderbook depth, volume profiles, and candlestick aggregation across 50 active liquidity pools.
						</p>
					</div>

					<div class="section-block">
						<div class="block-title">Carbon Indexing Framework Fork</div>
						<div class="block-sub">Forked from <a href="https://github.com/sevenlabs-hq/carbon" target="_blank" rel="noreferrer">[sevenlabs-hq/carbon]</a></div>
						<p>
							Forked the upstream carbon framework from sevenlabs-hq/carbon to introduce ClickHouse batch ingestion sinks capable of absorbing high network congestion without backpressure. Built an atomic confirmation notification service delivering instant alerts upon on-chain transaction finality.
						</p>
					</div>

					<div class="section-block">
						<div class="block-title">Protocol Math and AMM Decoders</div>
						<div class="block-sub">On-chain state decoding</div>
						<p>
							Implemented mathematical decoders for Solana liquidity protocols including Orca Whirlpools tick array traversal and sqrt price calculations, Meteora DLMM discrete price bin liquidity and volatility accumulators, Raydium CLMM and AMM pools, and Pyth Network price oracle feeds.
						</p>
					</div>
				</div>

				<div class="project-entry">
					<h3>Headless RustDesk</h3>
					<div class="sub">Derivative fork of RustDesk for headless and outbound only architectures</div>
					<div class="links">
						<a href="https://github.com/oasisMystre/rustdesk-client">[rustdesk-client]</a>
						<a href="https://github.com/oasisMystre/rustdesk-admin">[rustdesk-admin]</a>
						<a href="https://github.com/rustdesk/rustdesk" target="_blank" rel="noreferrer">[upstream rustdesk/rustdesk]</a>
					</div>
					<p>
						A derivative fork of the upstream <a href="https://github.com/rustdesk/rustdesk" target="_blank" rel="noreferrer">[rustdesk/rustdesk]</a> repository designed to eliminate graphical UI dependencies and implement a lightweight headless architecture for server environments and administrative workflows.
					</p>

					<div class="section-block">
						<div class="block-title">rustdesk-client</div>
						<div class="block-sub">Headless incoming remote desktop agent</div>
						<p>
							Complete rewrite of the RustDesk client as a headless application. Operates as an unattended background service to accept incoming connections, capture display output, and handle input injection without needing a local user interface, reducing runtime memory footprint by over 60 percent.
						</p>
					</div>

					<div class="section-block">
						<div class="block-title">rustdesk-admin</div>
						<div class="block-sub">Outgoing only client implementation</div>
						<p>
							Specialized RustDesk fork tailored exclusively for outbound operator management. Strips away inbound listener services to eliminate open port exposure and create a focused administrative client.
						</p>
					</div>
				</div>

				<div class="project-entry">
					<h3>Solana Deeplink Adapter</h3>
					<div class="sub">Mobile wallet integration protocol</div>
					<div class="links">
						<a href="https://github.com/oasisMystre/solana-wallets-vue">[github]</a>
					</div>
					<p>
						A protocol-level wallet adapter enabling mobile dApps, React Native apps, and mobile web browsers to interact with Phantom, Solflare, and Backpack wallets via mobile deeplinks where browser extension injection is not available.
					</p>
				</div>

				<div class="project-entry">
					<h3>Motus</h3>
					<div class="sub">Cross-platform fitness application</div>
					<div class="links">
						<a href="https://motus.fitness">[motus.fitness]</a>
						<a href="https://github.com/oasisMystre/motus">[github]</a>
					</div>
					<p>
						React Native mobile application built in a Turborepo monorepo with custom workout tracking logic and responsive styles.
					</p>
				</div>
			</section>

			<section>
				<h2>Skills</h2>

				<div class="skill-entry">
					<div class="skill-title">Systems Programming</div>
					<div class="skill-sub">Rust, C, C++, Assembly, Win32 APIs, Systems Architecture, Network Protocols</div>
				</div>

				<div class="skill-entry">
					<div class="skill-title">Data and Web3</div>
					<div class="skill-sub">Solana Runtime, Yellowstone Geyser gRPC, ClickHouse, Borsh, Orca Whirlpools, Raydium, Meteora DLMM, Pyth Network, Redis</div>
				</div>

				<div class="skill-entry">
					<div class="skill-title">Full Stack and Mobile</div>
					<div class="skill-sub">TypeScript, Python, Dart, React, React Native, Vite, Flutter, Django, Socket.IO, Bun, Docker</div>
				</div>
			</section>

			<section>
				<h2>Experience</h2>

				<div class="exp-entry">
					<h3>Rhiva</h3>
					<div class="sub">Founding Developer and Solo DevOps Engineer</div>
					<div class="links">
						<a href="https://rhiva.fun">[rhiva.fun]</a>
					</div>
					<p>
						Engineered the trading terminal and liquidity aggregation infrastructure. Implemented Yellowstone Geyser validator feeds, managed the ClickHouse time-series pipeline, forked the Carbon indexing framework, and built AMM mathematical decoders.
					</p>
				</div>

				<div class="exp-entry">
					<h3>Motus</h3>
					<div class="sub">Freelance Mobile Engineer</div>
					<div class="links">
						<a href="https://motus.fitness">[motus.fitness]</a>
					</div>
					<p>
						Developed mobile fitness application in React Native within a Turborepo monorepo setup with shared state management and offline synchronization.
					</p>
				</div>

				<div class="exp-entry">
					<h3>Independent Projects</h3>
					<div class="sub">Systems and Full Stack Engineer</div>
					<p>
						Created Desk0 remote desktop infrastructure and built Solana mobile wallet protocol integrations.
					</p>
				</div>
			</section>

			<section>
				<h2>Contact</h2>
				<p>
					Available for systems engineering, infrastructure contracts, and startup collaborations.
				</p>

				<div class="social-links">
					<a href="mailto:payouk.mystre@gmail.com" aria-label="Email" title="Email">
						<Icon name="email" size={20} />
					</a>
					<a href="https://github.com/oasisMystre" target="_blank" rel="noreferrer" aria-label="GitHub" title="GitHub">
						<Icon name="github" size={20} />
					</a>
					<a href="https://x.com/0nisaibogu" target="_blank" rel="noreferrer" aria-label="X / Twitter" title="X / Twitter">
						<Icon name="x" size={20} />
					</a>
					<a href="https://t.me/onisaibogu" target="_blank" rel="noreferrer" aria-label="Telegram" title="Telegram">
						<Icon name="telegram" size={20} />
					</a>
					<a href="https://desk0.app" target="_blank" rel="noreferrer" aria-label="Desk0 Website" title="Desk0 Website">
						<Icon name="desk0" size={20} />
					</a>
				</div>
			</section>
		</main>

		<footer>
			<hr />
			<p>Oguntunde Caleb Fiyinfoluwa</p>
		</footer>
	</body>
</html>

<style>
	header {
		margin-bottom: 34px;
	}

	.tagline {
		color: #9499a8;
		font-size: 14px;
		margin-bottom: 12px;
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-top: 12px;
	}

	.social-links a {
		color: #9499a8;
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		transition: color 0.15s ease, transform 0.15s ease;
	}

	.social-links a:hover {
		color: #ffffff;
		transform: translateY(-1px);
	}

	.project-entry,
	.exp-entry {
		margin-bottom: 36px;
	}

	.sub {
		color: #9499a8;
		font-size: 13px;
		margin-bottom: 8px;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-bottom: 12px;
		font-size: 13px;
	}

	.links a {
		text-decoration: none;
	}

	.links a:hover {
		text-decoration: underline;
	}

	.section-block {
		margin-top: 14px;
		margin-bottom: 14px;
		padding-left: 14px;
		border-left: 2px solid #22252c;
	}

	.block-title {
		color: #ffffff;
		font-weight: 600;
		font-size: 14px;
	}

	.block-sub {
		color: #9499a8;
		font-size: 12px;
		margin-bottom: 4px;
	}

	.section-block p {
		margin-bottom: 6px;
		font-size: 14px;
	}

	.skill-entry {
		margin-bottom: 16px;
	}

	.skill-title {
		color: #ffffff;
		font-weight: 600;
		font-size: 14px;
	}

	.skill-sub {
		color: #9499a8;
		font-size: 13px;
	}

	footer p {
		color: #888d9a;
		font-size: 12px;
	}
</style>
