---
import BaseHead from "../components/BaseHead.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<header>
			<h1>Oguntunde Caleb Fiyinfoluwa</h1>
			<p class="tagline">Systems and Infrastructure Engineer</p>

			<div class="social-links">
				<a href="mailto:payouk.mystre@gmail.com" aria-label="Email" title="Email">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect width="20" height="16" x="2" y="4" rx="2"></rect>
						<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
					</svg>
				</a>
				<a href="https://github.com/oasisMystre" target="_blank" rel="noreferrer" aria-label="GitHub" title="GitHub">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
						<path d="M9 18c-4.51 2-5-2-7-2"></path>
					</svg>
				</a>
				<a href="https://x.com/onisaibogu" target="_blank" rel="noreferrer" aria-label="X / Twitter" title="X / Twitter">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
						<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
					</svg>
				</a>
				<a href="https://desk0.app" target="_blank" rel="noreferrer" aria-label="Desk0 Website" title="Desk0 Website">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="12" cy="12" r="10"></circle>
						<line x1="2" y1="12" x2="22" y2="12"></line>
						<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
					</svg>
				</a>
			</div>
		</header>

		<main>
			<section>
				<h2>About</h2>
				<p>
					I build low level infrastructure, remote desktop protocols, and high frequency financial data pipelines. My core work focuses on systems engineering in Rust and C++, real time networking, and high throughput transaction ingestion on the Solana blockchain.
				</p>
			</section>

			<section>
				<h2>Projects</h2>

				<div class="project-entry">
					<h3>Desk0</h3>
					<div class="sub">Open source remote desktop and endpoint management infrastructure</div>
					<div class="links">
						<a href="https://desk0.app">[desk0.app]</a>
						<a href="https://github.com/oasisMystre/desk0">[github]</a>
					</div>
					<p>
						Desk0 is an open source remote desktop and endpoint management platform written in Rust. Features a bidirectional WebSocket proxy server for real time stream routing and an IPC interserver for communication between sessions.
					</p>

					<div class="section-block">
						<div class="block-title">WebSocket Relay Proxy</div>
						<div class="block-sub">Bidirectional stream routing</div>
						<p>
							Built a bidirectional proxy server using axum, tokio, and tokio-rustls to connect viewers and remote agents over secure WebSockets across network boundaries without opening inbound ports.
						</p>
					</div>

					<div class="section-block">
						<div class="block-title">IPC Interserver</div>
						<div class="block-sub">Cross-session communication</div>
						<p>
							Engineered an IPC interserver to coordinate messaging, input dispatch, and state synchronization between background management services and active desktop sessions.
						</p>
					</div>
				</div>

				<div class="project-entry">
					<h3>Rhiva</h3>
					<div class="sub">High frequency Solana trading terminal and liquidity aggregator</div>
					<div class="links">
						<a href="https://rhiva.fun">[rhiva.fun]</a>
						<a href="https://github.com/oasisMystre/carbon">[carbon fork]</a>
						<a href="https://github.com/sevenlabs-hq/carbon" target="_blank" rel="noreferrer">[upstream sevenlabs-hq/carbon]</a>
					</div>
					<p>
						Served as founding developer and solo DevOps engineer for Rhiva, designing the architecture from an early liquidity aggregator to an on-chain trading terminal.
					</p>

					<div class="section-block">
						<div class="block-title">Yellowstone Geyser Ingestion</div>
						<div class="block-sub">Direct validator gRPC streaming</div>
						<p>
							Replaced rate-limited HTTP JSON-RPC connections with direct Yellowstone Geyser gRPC validator feeds. Captured real-time slot commitments, account state transitions, and trade transactions directly from the validator gossip network.
						</p>
					</div>

					<div class="section-block">
						<div class="block-title">ClickHouse Storage Engine</div>
						<div class="block-sub">Real-time analytical time-series cluster</div>
						<p>
							Designed and maintained a ClickHouse database cluster built for high-throughput append-only transaction logs. Delivered sub-millisecond query performance for depth of market, volume profiles, candle aggregation, and trader transaction histories.
						</p>
					</div>

					<div class="section-block">
						<div class="block-title">Carbon Indexing Framework Fork</div>
						<div class="block-sub">Forked from <a href="https://github.com/sevenlabs-hq/carbon" target="_blank" rel="noreferrer">[sevenlabs-hq/carbon]</a></div>
						<p>
							Forked the upstream carbon framework from sevenlabs-hq/carbon to introduce ClickHouse batch ingestion sinks capable of absorbing high network congestion without backpressure. Built an atomic confirmation notification service delivering instant alerts upon on-chain transaction finality.
						</p>
					</div>

					<div class="section-block">
						<div class="block-title">Protocol Math and AMM Decoders</div>
						<div class="block-sub">On-chain state decoding</div>
						<p>
							Implemented mathematical decoders for Solana liquidity protocols including Orca Whirlpools tick array traversal and sqrt price calculations, Meteora DLMM discrete price bin liquidity and volatility accumulators, Raydium CLMM and AMM pools, and Pyth Network price oracle feeds.
						</p>
					</div>
				</div>

				<div class="project-entry">
					<h3>Headless RustDesk</h3>
					<div class="sub">Derivative fork of RustDesk for headless and outbound only architectures</div>
					<div class="links">
						<a href="https://github.com/oasisMystre/rustdesk-client">[rustdesk-client]</a>
						<a href="https://github.com/oasisMystre/rustdesk-admin">[rustdesk-admin]</a>
						<a href="https://github.com/rustdesk/rustdesk" target="_blank" rel="noreferrer">[upstream rustdesk/rustdesk]</a>
					</div>
					<p>
						A derivative fork of the upstream <a href="https://github.com/rustdesk/rustdesk" target="_blank" rel="noreferrer">[rustdesk/rustdesk]</a> repository designed to eliminate graphical UI dependencies and implement a lightweight headless architecture for server environments and administrative workflows.
					</p>

					<div class="section-block">
						<div class="block-title">rustdesk-client</div>
						<div class="block-sub">Headless incoming remote desktop agent</div>
						<p>
							Complete rewrite of the RustDesk client as a headless application. Operates as an unattended background service to accept incoming connections, capture display output, and handle input injection without needing a local user interface.
						</p>
					</div>

					<div class="section-block">
						<div class="block-title">rustdesk-admin</div>
						<div class="block-sub">Outgoing only client implementation</div>
						<p>
							Specialized RustDesk fork tailored exclusively for outbound operator management. Strips away inbound listener services to create a secure, focused administrative client.
						</p>
					</div>
				</div>

				<div class="project-entry">
					<h3>Solana Deeplink Adapter</h3>
					<div class="sub">Mobile wallet integration protocol</div>
					<div class="links">
						<a href="https://github.com/oasisMystre/solana-wallets-vue">[github]</a>
					</div>
					<p>
						A protocol-level wallet adapter enabling mobile dApps, React Native apps, and mobile web browsers to interact with Phantom, Solflare, and Backpack wallets via mobile deeplinks where browser extension injection is not available.
					</p>
				</div>

				<div class="project-entry">
					<h3>djira</h3>
					<div class="sub">Django async WebSocket framework</div>
					<div class="links">
						<a href="https://github.com/oasisMystre/djira">[github]</a>
						<a href="https://pypi.org/project/drf-sio/">[drf-sio on pypi]</a>
						<a href="https://github.com/oasisMystre/jira">[jira client]</a>
					</div>
					<p>
						Author of drf-sio on PyPI. Connects Django REST Framework with async Socket.IO servers. Maps standard REST actions over WebSocket streams, providing model observers, Django signal handlers, pagination, and Redis PubSub backend.
					</p>
				</div>

				<div class="project-entry">
					<h3>Trustmint</h3>
					<div class="sub">Web3 verification monorepo</div>
					<div class="links">
						<a href="https://github.com/oasisMystre/trustmint">[github]</a>
					</div>
					<p>
						Core monorepo containing libraries, token logic, and verification binaries for trustmint.fun.
					</p>
				</div>

				<div class="project-entry">
					<h3>Motus</h3>
					<div class="sub">Cross-platform fitness application</div>
					<div class="links">
						<a href="https://motus.fitness">[motus.fitness]</a>
						<a href="https://github.com/oasisMystre/motus">[github]</a>
					</div>
					<p>
						React Native mobile application built in a Turborepo monorepo with custom workout tracking logic and responsive styles.
					</p>
				</div>

				<div class="project-entry">
					<h3>Umbrella</h3>
					<div class="sub">Prioritized Solana token transfers</div>
					<div class="links">
						<a href="https://github.com/oasisMystre/umbrella">[github]</a>
					</div>
					<p>
						Utility for transferring Solana SPL tokens with priority fee optimization for congested network states.
					</p>
				</div>

				<div class="project-entry">
					<h3>LyricMarc</h3>
					<div class="sub">Synchronized song lyrics mobile app</div>
					<div class="links">
						<a href="https://github.com/oasisMystre/lyricmarc">[github]</a>
					</div>
					<p>
						Flutter mobile application for lyric retrieval, real-time scrolling, and track identification via music APIs.
					</p>
				</div>

				<div class="project-entry">
					<h3>Telegram Autonomous Bots</h3>
					<div class="sub">Production bot microservices</div>
					<div class="links">
						<a href="https://github.com/oasisMystre/memeflipai">[memeflipai]</a>
						<a href="https://github.com/oasisMystre/MuseAIBot">[MuseAIBot]</a>
						<a href="https://github.com/oasisMystre/profittown">[profittown]</a>
						<a href="https://github.com/oasisMystre/onboarding-bot">[onboarding-bot]</a>
					</div>

					<div class="section-block">
						<div class="block-title">MemeFlip AI</div>
						<div class="block-sub">Generative meme creation system</div>
						<p>
							Full stack application pairing a React and Vite interface with an asynchronous Telegram bot processing backend.
						</p>
					</div>

					<div class="section-block">
						<div class="block-title">MuseAIBot</div>
						<div class="block-sub">Audio model music generation</div>
						<p>
							Autonomous bot leveraging the Sona audio model to generate music tracks directly from user text prompts.
						</p>
					</div>

					<div class="section-block">
						<div class="block-title">ProfitTown</div>
						<div class="block-sub">Payment and accounting engine</div>
						<p>
							High performance ledger and transaction processing bot built on the Bun JavaScript runtime.
						</p>
					</div>

					<div class="section-block">
						<div class="block-title">Onboarding Bot</div>
						<div class="block-sub">Workflow automation pipeline</div>
						<p>
							Automated attendee onboarding and webinar engagement system.
						</p>
					</div>
				</div>
			</section>

			<section>
				<h2>Skills</h2>

				<div class="skill-entry">
					<div class="skill-title">Systems Programming</div>
					<div class="skill-sub">Rust, C, C++, Assembly, Win32 APIs, Systems Architecture, Network Protocols</div>
				</div>

				<div class="skill-entry">
					<div class="skill-title">Data and Web3</div>
					<div class="skill-sub">Solana Runtime, Yellowstone Geyser gRPC, ClickHouse, Borsh, Orca Whirlpools, Raydium, Meteora DLMM, Pyth Network, Redis</div>
				</div>

				<div class="skill-entry">
					<div class="skill-title">Full Stack and Mobile</div>
					<div class="skill-sub">TypeScript, Python, Dart, React, React Native, Vite, Flutter, Django, Socket.IO, Bun, Docker</div>
				</div>
			</section>

			<section>
				<h2>Experience</h2>

				<div class="exp-entry">
					<h3>Rhiva</h3>
					<div class="sub">Founding Developer and Solo DevOps Engineer</div>
					<div class="links">
						<a href="https://rhiva.fun">[rhiva.fun]</a>
					</div>
					<p>
						Engineered the trading terminal and liquidity aggregation infrastructure. Implemented Yellowstone Geyser validator feeds, managed the ClickHouse time-series pipeline, forked the Carbon indexing framework, and built AMM mathematical decoders.
					</p>
				</div>

				<div class="exp-entry">
					<h3>Motus</h3>
					<div class="sub">Freelance Mobile Engineer</div>
					<div class="links">
						<a href="https://motus.fitness">[motus.fitness]</a>
					</div>
					<p>
						Developed mobile fitness application in React Native within a Turborepo monorepo setup with shared state management and offline synchronization.
					</p>
				</div>

				<div class="exp-entry">
					<h3>Independent Projects</h3>
					<div class="sub">Systems and Full Stack Engineer</div>
					<p>
						Created Desk0 remote desktop infrastructure, authored drf-sio on PyPI, and deployed production Telegram bot microservices.
					</p>
				</div>
			</section>

			<section>
				<h2>Contact</h2>
				<p>
					Available for systems engineering, infrastructure contracts, and startup collaborations.
				</p>

				<div class="social-links">
					<a href="mailto:payouk.mystre@gmail.com" aria-label="Email" title="Email">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<rect width="20" height="16" x="2" y="4" rx="2"></rect>
							<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
						</svg>
					</a>
					<a href="https://github.com/oasisMystre" target="_blank" rel="noreferrer" aria-label="GitHub" title="GitHub">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
							<path d="M9 18c-4.51 2-5-2-7-2"></path>
						</svg>
					</a>
					<a href="https://x.com/onisaibogu" target="_blank" rel="noreferrer" aria-label="X / Twitter" title="X / Twitter">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
							<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
						</svg>
					</a>
					<a href="https://desk0.app" target="_blank" rel="noreferrer" aria-label="Desk0 Website" title="Desk0 Website">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"></circle>
							<line x1="2" y1="12" x2="22" y2="12"></line>
							<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
						</svg>
					</a>
				</div>
			</section>
		</main>

		<footer>
			<hr />
			<p>Oguntunde Caleb Fiyinfoluwa</p>
		</footer>
	</body>
</html>

<style>
	header {
		margin-bottom: 30px;
	}

	.tagline {
		color: #888888;
		margin-bottom: 12px;
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: 14px;
		margin-top: 10px;
	}

	.social-links a {
		color: #a0a0a0;
		display: inline-flex;
		align-items: center;
		transition: color 0.15s ease;
	}

	.social-links a:hover {
		color: #ffffff;
	}

	.project-entry,
	.exp-entry {
		margin-bottom: 32px;
	}

	.sub {
		color: #888888;
		font-size: 13px;
		margin-bottom: 6px;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 10px;
		font-size: 13px;
	}

	.section-block {
		margin-top: 14px;
		margin-bottom: 14px;
		padding-left: 12px;
		border-left: 2px solid #262626;
	}

	.block-title {
		color: #ffffff;
		font-weight: bold;
		font-size: 13px;
	}

	.block-sub {
		color: #777777;
		font-size: 12px;
		margin-bottom: 4px;
	}

	.section-block p {
		margin-bottom: 4px;
		font-size: 13px;
	}

	.skill-entry {
		margin-bottom: 14px;
	}

	.skill-title {
		color: #ffffff;
		font-weight: bold;
		font-size: 13px;
	}

	.skill-sub {
		color: #999999;
		font-size: 13px;
	}

	footer p {
		color: #555555;
		font-size: 12px;
	}
</style>
